# ---------- Home Assistant ----------
# Settings > Devices & services > Add integration > "Model Context Protocol Server"
# Token: your profile > Security > Long-lived access tokens
HA_MCP_URL=http://homeassistant.local:8123/api/mcp
HA_TOKEN=

# ---------- Primary LLM (any OpenAI-compatible endpoint) ----------
# Groq (fastest first-token in most tests):   https://api.groq.com/openai/v1
# Cerebras:                                   https://api.cerebras.ai/v1
# Gemini:                                     https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI:                                     https://api.openai.com/v1
# DeepSeek:                                   https://api.deepseek.com   (LLM_MODEL=deepseek-flash, see below)
# Local Ollama:                               http://127.0.0.1:11434/v1
# Model names change often: check the provider's model list.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Who Max is (story, personality) is his soul: edit it on the control panel (docs/SOUL.md).
# LLM_SYSTEM_PROMPT replaces only his operating rules (brevity, tools, honesty); rarely needed.
# SOUL_FILE=data/soul.md
# Give up on the primary if it hasn't started answering within this many ms
LLM_TIMEOUT_MS=4000

# ---- More AI models (bring your own) ----
# Background jobs (news briefings, website suggestions, filing memory, memory tidy-up) can each use
# their own model: add the key of any provider you want here, then choose the model per job on the
# control panel (Settings -> AI models). The conversation keeps the LLM_* model above.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                 # also used by Gemini Live voice (below): set it once
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1      # models on your own computer
# CUSTOM_LLM_BASE_URL=                            # any other OpenAI-compatible service
# CUSTOM_LLM_API_KEY=
# Only for models with a "thinking" mode. For DeepSeek set LLM_REASONING_EFFORT=none: thinking
# is on by default there and makes spoken replies much slower.
# LLM_REASONING_EFFORT=none
#
# DeepSeek example (key from https://platform.deepseek.com):
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-...
#   LLM_MODEL=deepseek-flash
#   LLM_REASONING_EFFORT=none
#   LLM_TIMEOUT_MS=8000

# ---------- Fallback LLM (used if primary fails / internet is down) ----------
# LLM_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
# LLM_FALLBACK_MODEL=qwen3:8b
# LLM_FALLBACK_REASONING_EFFORT=

# ---------- Voice services (docker compose) ----------
WAKEWORD_HOST=127.0.0.1
WAKEWORD_PORT=10400
# Keep only ONE WAKEWORD_NAMES line in .env: if there are two, the last one wins.
# Built in: hey_jarvis, okay_nabu, alexa, hey_mycroft, hey_rhasspy.
# Custom: the model file name in ./wakewords (hey_max.tflite -> hey_max), see training/README.md.
# Until "hey max" is trained, use hey_jarvis.
WAKEWORD_NAMES=hey_jarvis
# How sure the wake word engine must be before Max wakes (0-1). Lower = wakes more easily,
# but also by mistake. Run ./scripts/wake-coach.sh to measure your voice and get a suggestion.
# Apply with: docker compose up -d openwakeword
# WAKEWORD_THRESHOLD=0.5
# WAKEWORD_TRIGGER_LEVEL=1
# Waking up by itself (TV, music, clatter)? Try WAKEWORD_TRIGGER_LEVEL=2 (the wake word must be heard for
# two moments in a row: noise blips are ignored). Each wake-up is also double-checked by the speech
# recogniser (it must actually hear the wake word); WAKEWORD_VERIFY=off skips that check.
# WAKEWORD_VERIFY=on
STT_HOST=127.0.0.1
STT_PORT=10300
STT_LANGUAGE=en
TTS_HOST=127.0.0.1
TTS_PORT=10200
# TTS_VOICE=en_GB-alan-medium

# ---------- Home location ----------
# Where home is, for local answers and local web results. Easiest: set it on the control panel
# (Home location). These are only the default until you do.
# HOME_LOCATION=Clapham, London
# HOME_COUNTRY=GB

# ---------- Web search and reading pages (Firecrawl, built in: no Composio needed) ----------
# Free key at https://firecrawl.dev (Dashboard -> API keys). Max can then search the web and news
# and read any page ("what's the latest on...", "what are the opening hours of..."). See docs/APPS.md
# FIRECRAWL_API_KEY=fc-...
# Self-hosted Firecrawl instead of firecrawl.dev: its address (no key needed)
# FIRECRAWL_API_URL=http://firecrawl:3002

# ---------- Apps: Office 365, WhatsApp and more (via Composio) ----------
# 1. Get an API key at https://platform.composio.dev  2. Restart Max
# 3. Open the control panel http://localhost:8099 and click Connect for each app. See docs/APPS.md
# COMPOSIO_API_KEY=
# Apps to offer (Composio toolkit names): outlook = Office 365 mail + calendar
# COMPOSIO_TOOLKITS=outlook,whatsapp
# Which actions Max may use (wildcards). Fewer = faster, more accurate voice answers.
# Apps without any pattern here get all their actions (e.g. add firecrawl to COMPOSIO_TOOLKITS
# and it just works); add patterns like FIRECRAWL_SCRAPE* to narrow an app down.
# COMPOSIO_ALLOWED_TOOLS=OUTLOOK_*LIST*MESSAGE*,OUTLOOK_*SEARCH*,OUTLOOK_*GET*MESSAGE*,OUTLOOK_*SEND*,OUTLOOK_*REPLY*,OUTLOOK_*EVENT*,OUTLOOK_*CALENDAR*,OUTLOOK_*SCHEDULE*,WHATSAPP_SEND*,WHATSAPP_GET*
# COMPOSIO_USER_ID=max-home
# Work accounts, kept separate (docs/APPS.md "Personal and work accounts"): used only in work mode,
# connected under their own Composio user. Defaults to the same app list as COMPOSIO_TOOLKITS.
# COMPOSIO_WORK_TOOLKITS=outlook,linkedin,slack
# COMPOSIO_WORK_USER_ID=max-home-work
# Extra MCP servers of your own: copy config/mcp-servers.example.json to config/mcp-servers.json

# ---------- Memory and privacy (docs/MEMORY.md) ----------
# Encryption secret for Max's memory vaults: any long random string. Generate one with:
#   openssl rand -base64 32
# Keep a copy somewhere safe: without it the vaults can't be opened. If unset, Max generates one
# and stores it next to the vaults (works, but less secure).
# MEMORY_KEY=
# Work mode is on automatically during these hours (Work vault open); "off" = only by voice.
# WORK_HOURS=Mon-Fri 09:00-17:30
# Work apps: only offered in work mode, and what's learnt from them is filed under Work. Not needed once
# separate work accounts are connected (COMPOSIO_WORK_TOOLKITS): those already follow the mode.
# WORK_APPS=OUTLOOK_*
# Personal apps: hidden in work mode (the reverse of WORK_APPS).
# PERSONAL_APPS=WHATSAPP_*
# Password for the control panel (it shows Max's memory). Strongly recommended.
# PANEL_PASSWORD=
# MEMORY=off
# MEMORY_AUTO_LEARN=off            # stop filing conversations (uses the LLM_* model above)
# MEMORY_DIGESTS=off               # stop rolling old notes into weekly/monthly digests
# MEMORY_RECENT_CONVERSATIONS=3
# MEMORY_PROMPT_CHARS=2000

# ---------- Voice mode ----------
# pipeline = wake word -> speech-to-text -> LLM above -> text-to-speech below (default, cheap)
# realtime = wake word -> OpenAI Realtime speech-to-speech (most natural, paid per minute).
#            See docs/REALTIME.md. Uses the OpenAI key below; LLM_* and TTS_* are not used.
VOICE_MODE=pipeline
# Provider: openai (gpt-realtime) or gemini (Gemini Live: similar speed, roughly 10x cheaper)
# REALTIME_PROVIDER=openai
# OpenAI: REALTIME_API_KEY=sk-...   (defaults: REALTIME_MODEL=gpt-realtime-2, REALTIME_VOICE=cedar)
# REALTIME_API_KEY=
# Gemini: key from https://aistudio.google.com (billing enabled)
#   (defaults: REALTIME_MODEL=gemini-3.8-live, REALTIME_VOICE=Charon)
# GEMINI_API_KEY=
# REALTIME_MODEL=
# REALTIME_VOICE=
# Offer Max's actions in real-time mode (off = conversation only, to isolate set-up problems)
# REALTIME_TOOLS=on
# Leave out specific actions in real-time mode (wildcards), e.g. one Gemini rejects
# (find it with: docker compose run --rm max node dist/tools/gemini-check.js)
# REALTIME_EXCLUDE_TOOLS=
# Optional voice language/accent for Gemini, e.g. en-GB
# REALTIME_LANGUAGE=
# REALTIME_STYLE=Speak with a warm, calm British accent, like a witty butler. Keep replies short.
# How long a pause (ms) means you've finished speaking
# REALTIME_SILENCE_MS=500
# Interrupt Max mid-sentence by saying the wake word ("Hey Max, stop"). Works on normal speakers, in
# both voice modes (the name is historical).
# REALTIME_WAKE_INTERRUPT=on
# Also interrupt just by starting to talk. Only with headphones or echo cancellation, or he hears himself.
# REALTIME_BARGE_IN=off
# Seconds of quiet before the conversation (and the paid connection) closes
# REALTIME_FOLLOW_UP_MS=8000
# REALTIME_MAX_SESSION_S=300
# Optional: also log what you said (small extra cost), e.g. gpt-4o-mini-transcribe
# REALTIME_TRANSCRIBE_MODEL=

# ---------- Music (docs/MUSIC.md) ----------
# Start the Spotify speaker with: docker compose --profile max --profile music up -d
# (or set COMPOSE_PROFILES=max,music here and just run: docker compose up -d)
# MUSIC_DUCK_VOLUME=15

# ---------- Face screen (Max box, docs/PI.md) ----------
# Preview: http://localhost:8098/?demo
# FACE=off
# FACE_SLEEP=23:00-07:00            # sleepy face at night when idle; "off" to disable
# FACE_AUDIO_DELAY_MS=0             # if the mouth moves before you hear the voice, try 150-300 (Mac sound bridge)

# ---------- Voice (text-to-speech) ----------
# piper  = default, local, fast but robotic (voice set in docker-compose.yml)
# openai = any OpenAI-compatible speech API. Two good choices (details: docs/VOICES.md):
#   Kokoro, local + free + natural:  TTS_BASE_URL=http://kokoro:8880/v1  TTS_MODEL=kokoro  TTS_VOICE=bm_george
#     (start it with: docker compose --profile max --profile kokoro up -d;
#      use http://127.0.0.1:8880/v1 instead if you run Max with npm rather than Docker)
#   OpenAI cloud, most expressive, paid per use:
#     TTS_BASE_URL=https://api.openai.com/v1  TTS_API_KEY=sk-...  TTS_MODEL=gpt-4o-mini-tts  TTS_VOICE=onyx
#     TTS_INSTRUCTIONS=Speak like a calm, witty British butler. Warm, concise, slightly dry humour.
TTS_PROVIDER=piper
# TTS_BASE_URL=http://kokoro:8880/v1
# TTS_API_KEY=
# TTS_MODEL=kokoro
# TTS_INSTRUCTIONS=
# Sample rate of the "pcm" audio the speech API returns (24000 for Kokoro and OpenAI)
# TTS_SAMPLE_RATE=24000

# ---------- Audio (run `arecord -L` / `aplay -L` to list devices) ----------
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default
AUDIO_SAMPLE_RATE=16000
# How long (ms) the mic stays deaf after Max finishes speaking, so he never hears himself.
# Raise to 1500-2000 if Max answers his own words or two voices loop; lower for snappier follow-ups.
AUDIO_ECHO_TAIL_MS=1000
# Short chime when Max wakes up, so you know he's listening (on/off)
WAKE_CHIME=on

# ---------- End-of-speech detection (biggest hidden delay - tune per room) ----------
# Raise the threshold in noisy rooms; lower the silence for snappier (but riskier) replies.
VAD_RMS_THRESHOLD=500
VAD_SILENCE_MS=450
VAD_MAX_UTTERANCE_MS=10000

# Your time zone, so Max tells the right time and timers show the right end time
# (Docker containers default to UTC). List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

LOG_LEVEL=log

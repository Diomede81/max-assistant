# Run Jarvis on boot (Ubuntu). Copy to /etc/systemd/system/ and adjust paths/user:
#   sudo cp deploy/jarvis.service /etc/systemd/system/ && sudo systemctl enable --now jarvis
[Unit]
Description=Jarvis voice assistant
After=network-online.target sound.target docker.service
Wants=network-online.target

[Service]
User=jarvis
WorkingDirectory=/opt/jarvis-home
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

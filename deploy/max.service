# Run Max on boot (Ubuntu). Copy to /etc/systemd/system/ and adjust paths/user:
#   sudo cp deploy/max.service /etc/systemd/system/ && sudo systemctl enable --now max
[Unit]
Description=Max voice assistant
After=network-online.target sound.target docker.service
Wants=network-online.target

[Service]
User=max
WorkingDirectory=/opt/max-assistant
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

{
  "name": "max-assistant",
  "version": "0.1.0",
  "description": "Max: a low-latency voice assistant for Home Assistant (NestJS + MCP + Wyoming)",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mic-check": "tsc -p tsconfig.json && node dist/tools/mic-check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "openai": "^7.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}

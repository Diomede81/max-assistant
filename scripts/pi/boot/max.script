# Boot screen for the Max box: the logo in the middle of a dark screen (the face's own
# background colour), gently "breathing" while the box starts. A large logo is scaled down to
# fit the round screen.
Window.SetBackgroundTopColor(0.024, 0.035, 0.051);
Window.SetBackgroundBottomColor(0.024, 0.035, 0.051);

logo.image = Image("logo.png");
fit = Math.Min(Window.GetWidth(), Window.GetHeight()) * 0.62;
if (logo.image.GetWidth() > fit || logo.image.GetHeight() > fit) {
  ratio = Math.Min(fit / logo.image.GetWidth(), fit / logo.image.GetHeight());
  logo.image = logo.image.Scale(logo.image.GetWidth() * ratio, logo.image.GetHeight() * ratio);
}
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

tick = 0;
fun refresh_callback () {
  tick++;
  logo.sprite.SetOpacity(0.8 + 0.2 * Math.Sin(tick / 25));
}
Plymouth.SetRefreshFunction(refresh_callback);

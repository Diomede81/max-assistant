[Unit]
Description=Max face screen (kiosk)
After=systemd-user-sessions.service plymouth-quit-wait.service docker.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=__USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/local/bin/max-face-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target

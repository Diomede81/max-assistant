[Unit]
Description=Max: start or update Home Assistant on request
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=MAX_RUN_DIR=/run/max
ExecStart=/usr/local/lib/max/max-home.sh
# Downloading a new Home Assistant on a slow connection can take a while.
TimeoutStartSec=45min
